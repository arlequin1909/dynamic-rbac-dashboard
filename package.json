{
  "name": "dynamic-rbac-dashboard",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "predev": "npm run build -w packages/shared",
    "dev": "concurrently -n api,web -c blue,green \"npm run dev -w apps/api\" \"npm run dev -w apps/web\"",
    "build": "npm run build -w packages/shared && npm run build -w apps/api && npm run build -w apps/web",
    "pretest": "npm run build -w packages/shared",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "start:all": "docker compose up --build"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "eslint": "^9.39.5",
    "@typescript-eslint/parser": "^8.70.0",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.9.6",
    "eslint-config-prettier": "^10.1.8"
  }
}
