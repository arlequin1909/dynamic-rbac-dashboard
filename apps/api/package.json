{
  "name": "api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "build": "tsc -p .",
    "start": "node --env-file-if-exists=../../.env dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@app/shared": "*",
    "express": "^4.21.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "zod": "^3.23.8",
    "jose": "^5.9.6"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "tsx": "^4.19.2",
    "@types/express": "^4.17.21",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/node": "^22.9.0",
    "vitest": "^5.0.1",
    "@vitest/coverage-v8": "^5.0.1",
    "supertest": "^7.0.0",
    "@types/supertest": "^6.0.2",
    "msw": "^2.6.5"
  }
}
